<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.antrecapricorne</groupId>
        <artifactId>antre-du-capricorne</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>users-service</artifactId>
    <name>users-service</name>
    <description>Comptes, rôles, favoris, vérification des identifiants (PostgreSQL)</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Migrations SQL versionnées. Depuis Spring Boot 4, le starter Flyway est obligatoire. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Flyway 10+ : le support de PostgreSQL est un module à part -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Validation des entrées (Bean Validation : @NotBlank, @Pattern, @Size...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- JSON (Jackson 3) : déclaré explicitement, l'API répond en JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>

        <!-- Uniquement le hachage de mots de passe (BCrypt), sans Spring Security complet :
             Spring Security complet protégerait toutes les routes par défaut ; c'est le rôle du webapp. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Tests unitaires (JUnit, Mockito, AssertJ). Les tests avec une vraie base
             PostgreSQL (Testcontainers) arrivent à l'étape 6. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Vraie base PostgreSQL jetable pour les tests d'intégration (nécessite Docker allumé).
             Testcontainers 2.x : les modules s'appellent « testcontainers-<module> ».
             La version est fixée par Spring Boot : on ne la précise pas. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Nom du jar fixe : target/users-service.jar (utilisé par le Dockerfile) -->
        <finalName>users-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
